<Window x:Class="PearlAiAnalyst.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PearlAiAnalyst.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#88060910"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Canvas x:Name="SelectionCanvas"
            Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

        <!-- Hint Pill -->
        <Border x:Name="HintBanner"
                Canvas.Left="24"
                Canvas.Top="24"
                Background="#E6151D2E"
                BorderBrush="#00D4AA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding [RegionOverlayHint], Source={x:Static services:LocalizationService.Instance}}"
                       Foreground="#F1F5F9"
                       FontSize="13.5"
                       FontWeight="Medium" />
        </Border>

        <!-- Selection Frame -->
        <Border x:Name="SelectionRectBorder"
                Visibility="Collapsed"
                BorderBrush="#00D4AA"
                BorderThickness="2"
                Background="#1A00D4AA"
                IsHitTestVisible="False" />

        <!-- Live Dimension Readout -->
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#EE0A0E17"
                BorderBrush="#25324D"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeBadgeText"
                       Foreground="#00D4AA"
                       FontWeight="SemiBold"
                       FontSize="12" />
        </Border>
    </Canvas>
</Window>
