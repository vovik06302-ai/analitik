<UserControl x:Class="PearlAiAnalyst.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PearlAiAnalyst.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Accuracy Cards (1h, 2h, 4h) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DarkCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding [Accuracy1h], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                    <TextBlock Text="{Binding Accuracy1hText}"
                               Foreground="{StaticResource AccentTealBrush}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Accuracy1hSubText}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding [Accuracy2h], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                    <TextBlock Text="{Binding Accuracy2hText}"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Accuracy2hSubText}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource DarkCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding [Accuracy4h], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                    <TextBlock Text="{Binding Accuracy4hText}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Accuracy4hSubText}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource DarkCardStyle}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentTealBrush}"
                           VerticalAlignment="Center"
                           FontSize="12.5" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [BtnRefreshHistory], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadHistoryCommand}"
                            Margin="0,0,10,0" />
                    <Button Content="{Binding [BtnExportCsv], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCsvCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SQLite History DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DarkCardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#222E46"
                      Background="Transparent"
                      RowBackground="#151D2E"
                      AlternatingRowBackground="#192338"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#101624" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderBrush" Value="#25324D" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#20314D" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Binding="{Binding FormattedLocalTime}" Width="155" />
                    <DataGridTextColumn Header="Цена" Binding="{Binding PriceNow, Converter={StaticResource PriceFmt}}" Width="105" />
                    <DataGridTemplateColumn Header="Направление" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Direction, Converter={StaticResource DirToText}}"
                                           Foreground="{Binding Direction, Converter={StaticResource DirToBrush}}"
                                           FontWeight="Bold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Уверенность" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="100" />
                    <DataGridTextColumn Header="Цель" Binding="{Binding TargetPrice, Converter={StaticResource PriceFmt}}" Width="105" />
                    <DataGridTextColumn Header="Стоп" Binding="{Binding StopPrice, Converter={StaticResource PriceFmt}}" Width="105" />
                    <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="*" />
                    <DataGridTextColumn Header="Время ответа" Binding="{Binding FormattedResponseTime}" Width="105" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
