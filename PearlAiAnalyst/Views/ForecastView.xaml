<UserControl x:Class="PearlAiAnalyst.Views.ForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PearlAiAnalyst.Services"
             DataContextChanged="UserControl_DataContextChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,16">

            <!-- Constant Financial Disclaimer -->
            <Border Background="#1AEF4444"
                    BorderBrush="#44EF4444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,9"
                    Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 12,2 L 22,20 L 2,20 Z M 12,9 L 12,14 M 12,17 L 12,17.5"
                          Stroke="#F87171"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Margin="0,0,10,0" />
                    <TextBlock Text="{Binding [Disclaimer], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="#FCA5A5"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty State when no forecast has run yet -->
            <Border Style="{StaticResource DarkCardStyle}"
                    Visibility="{Binding HasForecast, Converter={StaticResource InvBoolToVis}}"
                    Margin="0,0,0,14"
                    Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#1A00D4AA" Margin="0,0,0,14">
                        <Path Data="M 3,17 L 9,11 L 13,15 L 21,7 M 15,7 L 21,7 L 21,13"
                              Stroke="{StaticResource AccentTealBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="26" Height="26"
                              Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding [EmptyForecastTitle], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding [EmptyForecastSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13.5"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Hero Forecast Card -->
            <Border Style="{StaticResource DarkCardStyle}"
                    Visibility="{Binding HasForecast, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>

                    <!-- Animated Direction Badge -->
                    <Border Grid.Column="0"
                            Width="112" Height="112"
                            CornerRadius="22"
                            Background="{Binding Direction, Converter={StaticResource DirToTint}}"
                            BorderBrush="{Binding Direction, Converter={StaticResource DirToBrush}}"
                            BorderThickness="1.5"
                            Margin="0,0,22,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse x:Name="DirectionPulseRing"
                                     Width="86" Height="86"
                                     Stroke="{Binding Direction, Converter={StaticResource DirToBrush}}"
                                     StrokeThickness="1.2"
                                     Opacity="0.35">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.55" Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <Path x:Name="DirectionArrowIcon"
                                  Data="{Binding Direction, Converter={StaticResource DirToGeo}}"
                                  Fill="{Binding Direction, Converter={StaticResource DirToBrush}}"
                                  Width="48" Height="48"
                                  Stretch="Uniform"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="ArrowFloatTransform" Y="0" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="-3" To="3" Duration="0:0:1.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                    </Border>

                    <!-- Direction Title, Price, Confidence Bar -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding [LabelDirection], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <TextBlock Text="{Binding Direction, Converter={StaticResource DirToText}}"
                                       Foreground="{Binding Direction, Converter={StaticResource DirToBrush}}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,0,18,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LabelCurrentPrice], Source={x:Static services:LocalizationService.Instance}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{Binding PriceNowText}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding [LabelConfidence], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12.5" />
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding Direction, Converter={StaticResource DirToBrush}}">
                                <Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="%" />
                            </TextBlock>
                        </Grid>

                        <Border Height="10" CornerRadius="5" Background="#0D131F" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <ProgressBar x:Name="ConfidenceBar"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding Confidence}"
                                         Background="Transparent"
                                         Foreground="{Binding Direction, Converter={StaticResource DirToBrush}}"
                                         BorderThickness="0" />
                        </Border>
                    </StackPanel>

                    <!-- Meta Info Column -->
                    <Border Grid.Column="2"
                            Background="#0E1420"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding [LabelModel], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ModelInfoText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />

                            <TextBlock Text="{Binding [LabelResponseTime], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ResponseTimeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}" Margin="0,2,0,8" />

                            <TextBlock Text="Обновлено" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding UpdatedAtText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Levels Grid -->
            <Grid Visibility="{Binding HasForecast, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DarkCardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding [LabelTargetPrice], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TargetPriceText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="17" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding [LabelStopPrice], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding StopPriceText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="17" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource DarkCardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding [LabelSupport], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SupportText}"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource DarkCardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding [LabelResistance], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ResistanceText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Reasons & Risks 2-Column Layout -->
            <Grid Visibility="{Binding HasForecast, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chart Reasons & Risks -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource DarkCardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [LabelChartReasons], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding ChartReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource AccentTealBrush}" Margin="0,7,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DarkCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding [LabelRisks], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Risks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,7,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- News Impact & News Reasons -->
                <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [LabelNewsImpact], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding NewsImpactText}"
                                   TextWrapping="Wrap"
                                   FontSize="13.5"
                                   LineHeight="20"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="{Binding [LabelNewsReasons], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding NewsReasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,7,10,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Last Screenshot Preview Card -->
            <Border Style="{StaticResource DarkCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding [LabelLastScreenshot], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScreenshotPathText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />
                    </Grid>

                    <Border Background="#0A0E17"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            MinHeight="180"
                            MaxHeight="340"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding [NoData], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ScreenshotPreview, Converter={StaticResource NotEmptyToVis}, ConverterParameter=Invert}" />
                            <Image Source="{Binding ScreenshotPreview}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
