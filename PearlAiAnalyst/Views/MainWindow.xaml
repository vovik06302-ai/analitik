<Window x:Class="PearlAiAnalyst.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PearlAiAnalyst.Views"
        xmlns:services="clr-namespace:PearlAiAnalyst.Services"
        Title="Pearl AI Analyst"
        Width="1220"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A00D4AA" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1.2" Margin="0,0,10,0">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource AccentTealBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1.0" Duration="0:0:1.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding [AppTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding [SubtitlePair], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11" Foreground="{StaticResource AccentTealBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavForecast"
                                 Content="{Binding [NavForecast], Source={x:Static services:LocalizationService.Instance}}"
                                 Style="{StaticResource NavTabStyle}"
                                 IsChecked="True"
                                 Click="NavButton_Click"
                                 Tag="0" />
                    <RadioButton x:Name="NavNews"
                                 Content="{Binding [NavNews], Source={x:Static services:LocalizationService.Instance}}"
                                 Style="{StaticResource NavTabStyle}"
                                 Click="NavButton_Click"
                                 Tag="1" />
                    <RadioButton x:Name="NavHistory"
                                 Content="{Binding [NavHistory], Source={x:Static services:LocalizationService.Instance}}"
                                 Style="{StaticResource NavTabStyle}"
                                 Click="NavButton_Click"
                                 Tag="2" />
                    <RadioButton x:Name="NavSettings"
                                 Content="{Binding [NavSettings], Source={x:Static services:LocalizationService.Instance}}"
                                 Style="{StaticResource NavTabStyle}"
                                 Click="NavButton_Click"
                                 Tag="3" />
                </StackPanel>

                <!-- Bottom Model Selector, Status & Version -->
                <StackPanel Grid.Row="2">
                    <Border Background="#151D2E"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding [SidebarModelSection], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="↻"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Cursor="Hand"
                                        ToolTip="{Binding [BtnRefreshModelsTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding RefreshOllamaStatusCommand}" />
                            </Grid>

                            <ComboBox ItemsSource="{Binding Providers}"
                                      SelectedItem="{Binding SelectedProvider}"
                                      IsEnabled="{Binding CanChangeProvider}"
                                      Margin="0,0,0,8" />

                            <ComboBox ItemsSource="{Binding ActiveModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      IsEnabled="{Binding CanSelectModel}"
                                      ToolTip="{Binding SelectedModel}" />

                            <TextBlock Text="{Binding ModelSelectorHint}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ModelSelectorHint, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#151D2E"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding [ConnectionStatusHeader], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="↻"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Cursor="Hand"
                                        ToolTip="{Binding [BtnRefreshConnectionsTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding RefreshConnectionsCommand}" />
                            </Grid>

                            <!-- Ollama Status Row -->
                            <Grid Background="Transparent"
                                  ToolTip="{Binding OllamaTroubleshootingTooltip}"
                                  Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding OllamaConnectionState, Converter={StaticResource ConnToBrush}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OllamaStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Width="16" Height="16"
                                        CornerRadius="8"
                                        Background="#1B263B"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="?"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Claude API Status Row -->
                            <Grid Background="Transparent"
                                  ToolTip="{Binding ClaudeTroubleshootingTooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding ClaudeConnectionState, Converter={StaticResource ConnToBrush}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ClaudeStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Width="16" Height="16"
                                        CornerRadius="8"
                                        Background="#1B263B"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="?"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding OllamaOfflineHint}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding OllamaOfflineHint, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding AppVersionText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Action Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#101624" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock Text="{Binding RegionBadgeText}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>

                        <Button Content="{Binding [BtnSelectRegion], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectRegionCommand}"
                                IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvBool}}"
                                Margin="0,0,10,0" />

                        <Border Background="#1A00D4AA"
                                BorderBrush="#4400D4AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Visibility="{Binding IsAutoModeActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Авто: " Foreground="{StaticResource AccentTealBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AutoCountdownText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Animated Spinner + Step Text -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                            <Path Data="M 10,2 A 8,8 0 1 1 2,10"
                                  Stroke="{StaticResource AccentTealBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  Width="18" Height="18"
                                  Margin="0,0,8,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                            <TextBlock Text="{Binding AnalysisStepText}"
                                       Foreground="{StaticResource AccentTealBrush}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunAnalysisCommand}"
                                IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvBool}}"
                                MinWidth="185">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding [BtnAnalyzeNow], Source={x:Static services:LocalizationService.Instance}}" />
                                            <Setter Property="Foreground" Value="#071216" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                    <Setter Property="Text" Value="{Binding [BtnAnalyzing], Source={x:Static services:LocalizationService.Instance}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Grid.Row="1"
                    Background="#22EF4444"
                    BorderBrush="#66EF4444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorBannerText, Converter={StaticResource NotEmptyToVis}}">
                <Grid>
                    <TextBlock Text="{Binding ErrorBannerText}" Foreground="#FCA5A5" FontSize="13" TextWrapping="Wrap" Margin="0,0,30,0" />
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FCA5A5"
                            Cursor="Hand"
                            Command="{Binding DismissErrorCommand}" />
                </Grid>
            </Border>

            <!-- Info Banner -->
            <Border Grid.Row="2"
                    Background="#1A00D4AA"
                    BorderBrush="#4400D4AA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding InfoBannerText, Converter={StaticResource NotEmptyToVis}}">
                <Grid>
                    <TextBlock Text="{Binding InfoBannerText}" Foreground="{StaticResource AccentTealBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,30,0" />
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentTealBrush}"
                            Cursor="Hand"
                            Command="{Binding DismissInfoCommand}" />
                </Grid>
            </Border>

            <!-- Animated Screen Container -->
            <Grid x:Name="ScreenHost" Grid.Row="3" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" />
                </Grid.RenderTransform>

                <views:ForecastView DataContext="{Binding Forecast}"
                                    x:Name="ForecastViewControl"
                                    Visibility="Visible" />
                <views:NewsView DataContext="{Binding News}"
                                x:Name="NewsViewControl"
                                Visibility="Collapsed" />
                <views:HistoryView DataContext="{Binding History}"
                                   x:Name="HistoryViewControl"
                                   Visibility="Collapsed" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    x:Name="SettingsViewControl"
                                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
