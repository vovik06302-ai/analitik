<UserControl x:Class="PearlAiAnalyst.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PearlAiAnalyst.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource DarkCardStyle}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [NavNews], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="17" FontWeight="Bold" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Обновлено: " />
                        <Run Text="{Binding LastUpdatedText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Button Content="{Binding [BtnRefreshNews], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshNewsCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Error message -->
        <Border Grid.Row="1"
                Background="#1AEF4444"
                BorderBrush="#44EF4444"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Empty State -->
        <Border Grid.Row="2"
                Style="{StaticResource DarkCardStyle}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Top"
                Padding="36">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding [NoNewsFound], Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Проверьте список RSS-лент и ключевых слов в настройках."
                           FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- News List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DarkCardStyle}" Padding="16" Margin="0,0,8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#1A38BDF8" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#1A00D4AA" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding MatchedQuery}" Foreground="{StaticResource AccentTealBrush}" FontSize="11.5" />
                                        </Border>
                                        <TextBlock Text="{Binding FormattedDate}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Открыть ↗"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
