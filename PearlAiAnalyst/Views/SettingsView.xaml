<UserControl x:Class="PearlAiAnalyst.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PearlAiAnalyst.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,20">

            <!-- Capture & Schedule -->
            <Border Style="{StaticResource DarkCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsSectionCapture], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [LabelRegion], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding RegionDisplayText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding [BtnSelectRegion], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectRegionCommand}" />
                    </Grid>

                    <CheckBox Content="{Binding [SettingsAutoEnabled], Source={x:Static services:LocalizationService.Instance}}"
                              IsChecked="{Binding AutoModeEnabled}"
                              Margin="0,4,0,12" />

                    <TextBlock Text="{Binding [SettingsIntervalLabel], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding AutoIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="140" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- AI Provider -->
            <Border Style="{StaticResource DarkCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsSectionAi], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding [SettingsProviderLabel], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding Provider}"
                              Width="220" HorizontalAlignment="Left" Margin="0,0,0,14" />

                    <!-- Ollama Settings -->
                    <StackPanel Visibility="{Binding Provider, Converter={StaticResource ProviderEquals}, ConverterParameter=Ollama}">
                        <Border Background="#0E1420"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                ToolTip="{Binding OllamaTroubleshootingTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding OllamaConnectionState, Converter={StaticResource ConnToBrush}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OllamaStatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="#1B263B"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="?"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding [SettingsOllamaUrl], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [SettingsOllamaModel], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedOllamaListItem}" />
                            <Button Grid.Column="2"
                                    Content="{Binding [BtnRefreshModels], Source={x:Static services:LocalizationService.Instance}}"
                                    ToolTip="{Binding [BtnRefreshModelsTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshOllamaModelsCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding [SettingsOllamaModelManual], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding OllamaModelsHint}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding OllamaModelsHint, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>

                    <!-- Claude Settings -->
                    <StackPanel Visibility="{Binding Provider, Converter={StaticResource ProviderEquals}, ConverterParameter=Claude}">
                        <Border Background="#0E1420"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                ToolTip="{Binding ClaudeTroubleshootingTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding ClaudeConnectionState, Converter={StaticResource ConnToBrush}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ClaudeStatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="#1B263B"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="?"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4"
                                        Content="{Binding [BtnTestConnection], Source={x:Static services:LocalizationService.Instance}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5"
                                        FontSize="12"
                                        Command="{Binding TestClaudeConnectionCommand}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding [SettingsClaudeKey], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ClaudeApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [SettingsClaudeModel], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableClaudeModels}"
                                  SelectedItem="{Binding SelectedClaudeListItem}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [SettingsClaudeModelManual], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- News Sources -->
            <Border Style="{StaticResource DarkCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsSectionNews], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="Ключевые слова для поиска новостей"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Добавить" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddKeywordCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NewsKeywords}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1B263B" BorderBrush="#25324D" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="✕"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.RemoveKeywordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="RSS-ленты"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewRssUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Добавить RSS" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddRssFeedCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RssFeeds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0E1420" BorderBrush="#25324D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Content="Удалить"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,3"
                                                FontSize="11.5"
                                                Command="{Binding DataContext.RemoveRssFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Notifications, System & Updates -->
            <Border Style="{StaticResource DarkCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsSectionNotifications], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" Margin="0,0,0,14" />

                    <CheckBox Content="{Binding [SettingsNotifyDirection], Source={x:Static services:LocalizationService.Instance}}"
                              IsChecked="{Binding NotifyOnDirectionChange}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="{Binding [SettingsNotifyThreshold], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NotifyConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" HorizontalAlignment="Left" Margin="0,0,0,14" />

                    <CheckBox Content="{Binding [SettingsMinimizeToTray], Source={x:Static services:LocalizationService.Instance}}"
                              IsChecked="{Binding MinimizeToTrayOnClose}"
                              Margin="0,0,0,10" />

                    <CheckBox Content="{Binding [SettingsAutoStart], Source={x:Static services:LocalizationService.Instance}}"
                              IsChecked="{Binding AutoStartWithWindows}"
                              Margin="0,0,0,14" />

                    <TextBlock Text="{Binding [SettingsLanguage], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Width="140" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,14" />

                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [LabelVersion], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding AppVersionText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" />
                        </StackPanel>

                        <Button Content="{Binding [BtnCheckUpdates], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CheckUpdatesCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Footer -->
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentTealBrush}"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button Content="{Binding [BtnSaveSettings], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Right"
                        MinWidth="190" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
