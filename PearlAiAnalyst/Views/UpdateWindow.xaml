<Window x:Class="PearlAiAnalyst.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PearlAiAnalyst.Services"
        Title="Доступно обновление"
        Width="520"
        Height="410"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="38" Height="38" CornerRadius="10" Background="#1A00D4AA" Margin="0,0,12,0">
                <Path Data="M 12,3 L 12,16 M 6,11 L 12,17 L 18,11 M 5,20 L 19,20"
                      Stroke="{StaticResource AccentTealBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding [UpdateAvailableTitle], Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="18"
                           FontWeight="Bold" />
                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Текущая: " />
                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}" />
                    <Run Text="  →  Новая: " />
                    <Run Text="{Binding NewVersionText, Mode=OneWay}" Foreground="{StaticResource AccentTealBrush}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Список изменений:"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12.5"
                   Margin="0,16,0,6" />

        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ReleaseNotes}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding [UpdateDownloading], Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock HorizontalAlignment="Right"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentTealBrush}">
                    <Run Text="{Binding DownloadProgress, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
            </Grid>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                         Height="8"
                         Background="{StaticResource BgElevatedBrush}"
                         Foreground="{StaticResource AccentTealBrush}"
                         BorderThickness="0" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding [BtnUpdateLater], Source={x:Static services:LocalizationService.Instance}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LaterCommand}"
                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}"
                    MinWidth="100"
                    Margin="0,0,10,0" />
            <Button Content="{Binding [BtnUpdateNow], Source={x:Static services:LocalizationService.Instance}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding UpdateNowCommand}"
                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}"
                    MinWidth="130" />
        </StackPanel>
    </Grid>
</Window>
