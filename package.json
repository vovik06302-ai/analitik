{
  "name": "pearl-ai-analyst",
  "private": true,
  "version": "1.0.19",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:desktop": "vite build && node scripts/build-electron.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "description": "Pearl AI Analyst — настольное приложение",
  "author": "vovik06302-ai",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pearl.aianalyst",
    "productName": "Pearl AI Analyst",
    "asar": false,
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build-electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PearlAiAnalyst-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pearl AI Analyst"
    }
  }
}
